<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<!-- On the Data Protection keychain, the FIRST entry here is the
		     default access group for any keychain call that doesn't set
		     kSecAttrAccessGroup explicitly (e.g. KeychainCredentialStore's
		     per-host credentials). Keep the app's own group first so those
		     unscoped calls keep resolving to the app's own scope instead of
		     silently landing in the shared key-library group below. -->
		<string>$(AppIdentifierPrefix)org.szatmary.sloop</string>
		<string>$(AppIdentifierPrefix)org.szatmary.sloop.shared</string>
		<!-- Per-host credentials and Cloudflare Access tokens, shared with the
		     File Provider extension. Deliberately not the `.shared` group above:
		     that one is synchronizable and rides iCloud Keychain to every
		     device, while these items are AfterFirstUnlockThisDeviceOnly and are
		     meant never to leave this one. Solving a process-boundary problem by
		     moving them into a synced group would change their sync posture as
		     an invisible side effect. -->
		<string>$(AppIdentifierPrefix)org.szatmary.sloop.fileprovider</string>
	</array>
	<!-- Shared with the File Provider extension: the host list, the
	     known-hosts database, each domain's item index, and tsnet state. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.szatmary.sloop</string>
	</array>
</dict>
</plist>
