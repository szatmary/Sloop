# Xcode / generated project (regenerate with `xcodegen generate`)
*.xcodeproj
*.xcworkspace
!Package.xcworkspace
DerivedData/
build/
.build/

# SwiftPM
Package.resolved
.swiftpm/

# macOS
.DS_Store

# User-specific Xcode state
xcuserdata/
*.xcuserstate

# Vendored native binaries (built locally, see Docs/)
Vendor/**/*.xcframework
Vendor/**/build/

# Native dependency sources + build trees, cloned and compiled locally by the
# scripts in Scripts/ (openssl, libssh2, ios-cmake). Hundreds of megabytes.
.native*/

# Claude Code session state + worktrees
.claude/
